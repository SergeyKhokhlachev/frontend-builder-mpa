mixin card-action(data = {})
	-
		data = {
			image: data.image || '',
			path: data.path || '',
			name: data.name || '',
			text: data.text || '',
			date: data.date || '',
			markers: data.markers || [],
		}

	.card-action&attributes(attributes)
		.card-action__preview
			.card-action__date= data.date
			a(class="card-action__img" href="#" aria-label=data.name)
				+picture(data.image, {
					format: 'jpg',
					path: data.path,
					lazy: true,
					alt: '',
				})
		.card-action__content
			a(class="card-action__name" href="#" aria-label=data.name)= data.name
			p.card-action__text= data.text
