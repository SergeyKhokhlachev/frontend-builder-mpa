mixin card-review(data = {})
	-
		data = {
			avatar: data.avatar || '',
			color: data.color || '#2968E3',
			name: data.name || '',
			date: data.date || '',
			rating: data.rating || '5',
			title: data.title || '',
			text: data.text || '',
		}

	.card-review&attributes(attributes)
		.card-review__head
			div(style={background: data.color} class="card-review__avatar")= data.avatar
			.card-review__info
				time.card-review__date= data.date
				span.card-review__name= data.name 
		.card-review__body
			.card-review__content
				a(class="card-review__title" href="#" aria-label=data.title)= data.title
				p.card-review__text= data.text
			a(class="card-review__more link" href="#" aria-label="Перейти к отзыву")
				| Перейти к отзыву
				+icon('chevron-right')
