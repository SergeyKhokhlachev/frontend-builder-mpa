mixin swiper-banner(data = [])
	.swiper-banner&attributes(attributes)
		.swiper.js-swiper-banner
			.swiper-wrapper
				each item in data
					-
						item = {
							image: item.image || '',
							path: item.path || '',
							category: item.category || '',
							name: item.name || '',
							text: item.text || '',
						}

					.swiper-slide
						.swiper-banner__slide
							.swiper-banner__image
								+picture(item.image, {
									format: 'jpg',
									path: item.path,
									alt: '',
									lazy: true,
									responsive: [
										{
											media: 'largest'
										}, {
											media: 'desktop'
										}, {
											media: 'tablet'
										}
									]
								})
							.swiper-banner__box
								.swiper-banner__content
									span.swiper-banner__category= item.category
									p.swiper-banner__name= item.name
									p.swiper-banner__text= item.text
									.swiper-banner__buttons
										a(class="button button--primary" href="#" aria-label="Перейти в каталог")
											span Перейти в каталог
										a(class="button button--outline" href="#" aria-label="Читать статью")
											span Читать статью

		.swiper-pagination.swiper-pagination--point.js-swiper-pagination

		button(
			class="button-sq button-sq--largest"
			class="swiper-prev js-swiper-prev"
			type="button"
			aria-label="Назад"
		)
			+icon('chevron-left')
		button(
			class="button-sq button-sq--largest"
			class="swiper-next js-swiper-next"
			type="button"
			aria-label="Вперед"
		)
			+icon('chevron-right')
