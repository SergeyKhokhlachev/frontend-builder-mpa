mixin swiper-carousel(options = {})
	-
		options = {
			init: options.init || '',
			control: options.control || true,
		}

	div(class="swiper-carousel")&attributes(attributes)
		div(class="swiper-carousel__swiper swiper" class=options.init)
			.swiper-carousel__wrapper.swiper-wrapper
				block

		.swiper-scrollbar.js-swiper-scrollbar

		if (options.control)
			button(
				class="button-sq swiper-prev js-swiper-prev"
				type="button"
				aria-label="Назад"
			)
				+icon('chevron-left')
			button(
				class="button-sq swiper-next js-swiper-next"
				type="button"
				aria-label="Вперед"
			)
				+icon('chevron-right')
