mixin promo(data = {}, options = {})
	-
		data = {
			image: data.image || 'promo-banner',
			path: data.path || 'promo/',
		}

	div(class="promo")&attributes(attributes)
		a(class="promo__banner-link" href="#" aria-label="Баннер")
			+picture(data.image, {
				format: 'jpg',
				path: data.path,
				alt: '',
				lazy: true,
				responsive: [
					{
						media: 'desktop'
					}, {
						media: 'laptop'
					}, {
						media: 'tablet'
					}
				]
			})
		
