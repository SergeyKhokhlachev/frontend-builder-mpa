mixin logo(data = {}, options = {})
	a(class="logo" href="/" aria-label="KISLOROD")&attributes(attributes)
		img(
			class="logo__picture"
			src="/assets/images/logo-picture.svg"
			alt=""
			width="34"
			height="34"
		)
		img(
			class="logo__name"
			src="/assets/images/logo.svg"
			alt="KISLOROD"
			width="148"
			height="14"
		)
