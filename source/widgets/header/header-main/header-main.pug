mixin header-main(data = {}, options = {})
	.header-main.container&attributes(attributes)
		+logo()(class="header-main__logo")
		+header-search()(class="header-main__search")
		.header-main__control
			.header-control
				a(class="header-control__link" href="#" aria-label="Войти")
					+icon('login')
					span.header-control__name Войти
			.header-control
				a(class="header-control__link" href="#" aria-label="Сравнение")
					+icon('compare')
					span.header-control__name Сравнение
			.header-control
				a(class="header-control__link" href="#" aria-label="Избранное")
					+icon('favorite')
					span.header-control__count
					span.header-control__name Избранное
			.header-control
				a(class="header-control__link" href="#" aria-label="Корзина")
					+icon('cart')
					span.header-control__count
					span.header-control__name Корзина
