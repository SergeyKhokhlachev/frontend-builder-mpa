mixin header-top(data = {}, options = {})
	-
		const navigate = [
			{
				name: 'О компании',
				list: [
					'Сотрудничество',
					'Сертификаты',
					'Партнеры'
				]
			}, {
				name: 'Доставка и оплата',
			}, {
				name: 'Покупателям',
				list: [
					'Бонусная система',
					'Возврат',
					'Гарантия'
				]
			}, {
				name: 'Магазины',
			}, {
				name: 'Для бизнеса',
			}
		]

	.header-top&attributes(attributes)
		.container
			+location()(class="header-top__location")
			+header-nav(navigate)(class="header-top__nav")
			+phone()(class="header-top__phone")
