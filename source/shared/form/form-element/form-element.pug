mixin form-element(data = {}, options= {})
	-
		data = {
			id: data.id || false,
			label: data.label || false,
			describe: data.describe || false,
			required: data.required || false,
			readonly: data.readonly || false,
			disabled: data.disabled || false,
		}

	div(
		class="form-element js-form-element"
		class={
			required: data.required,
			readonly: data.readonly,
			disabled: data.disabled
		}
	)&attributes(attributes)
		if (data.label)
			label(class="form-element__label" for=data.id)
				span= data.label
				if (data.required)
					span.form-element__required *

		.form-element__field
			block

		if (data.describe)
			.form-element__describe= data.describe

		.form-element__message.js-form-element__message
