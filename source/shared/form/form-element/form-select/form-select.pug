mixin form-select(data = {}, options= {})
	-
		data = {
			id: data.id || data.name || false,
			name: data.name || false,
			label: data.label || false,
			message: data.message || false,
			describe: data.describe || false,
			placeholder: data.placeholder || false,
			required: data.required || false,
			readonly: data.readonly || false,
			disabled: data.disabled || false,
			look: data.look || false,
			multiple: data.multiple || false,
			options: data.options || [],
		}

	+form-element(data)
		div(class="form-select js-form-select" class={ multiple: data.multiple })
			select(
				id= data.id
				class="hidden"
				name= data.name
				required= data.required
				data-message= data.message
				data-look= data.look
				multiple= data.multiple
			)
				option(value="" disabled selected)= data.placeholder
				each item in data.options
					option(value=item.value selected=item.selected)= item.text

			.form-select__control.js-form-select__control
				.form-select__vue.form-select__vue--placeholder= data.placeholder
				.form-select__result.js-form-select__result
				+icon('chevron-down')(class="form-select__icon-dropdown")
			.form-select__dropdown.js-form-select__dropdown
				.form-select__scrollbar.js-form-select__scrollbar
					.form-select__options.js-form-select__options

