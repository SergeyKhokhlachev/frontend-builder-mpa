mixin form-checkbox(data = {}, options= {})
	-
		data = {
			id: data.id || data.name || false,
			name: data.name || false,
			checked: data.checked || false,
			label: data.label || false,
			required: data.required || false,
			readonly: data.readonly || false,
			disabled: data.disabled || false,
			look: data.look || false,
		}

	div(
		class="form-checkbox js-form-element"
		class={
			required: data.required,
			readonly: data.readonly,
			disabled: data.disabled
		}
	)&attributes(attributes)
		.form-checkbox__control
			input(
				id= data.id
				class="form-checkbox__input"
				type="checkbox"
				name= data.name
				checked= data.checked
				required= data.required
				data-look= data.look
				data-type="form-checkbox"
			)
			.form-checkbox__vue
				+icon('check')
		if (data.label)
			label(class="form-checkbox__label" for=data.id) !{data.label}

