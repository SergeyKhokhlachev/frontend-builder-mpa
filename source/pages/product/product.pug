extends ../../layouts/main/main

block data
	-
		const images = ['product-1', 'product-2', 'product-3']

block main
	.template-page
		.container
			.demo
				.demo-wrapper
					.product-swiper.js-product-swiper
						.swiper.product-swiper-main
							.swiper-wrapper
								each image in images
									.swiper-slide.swiper-slide-image
										.swiper-zoom-container
											+picture(image, {
												format: 'jpg',
												path: 'product/',
												alt: '',
												lazy: true,
											})(class="product-swiper__item")
										svg(class="product-swiper__zoom" width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg")
											path(d="M4.61027 26.8932C10.2845 32.5674 19.2292 33.0009 25.4156 28.1936L36.6457 39.4237C37.4141 40.1921 38.6553 40.1921 39.4237 39.4237C40.1921 38.6553 40.1921 37.4141 39.4237 36.6457L28.1936 25.4156C33.0206 19.2292 32.5674 10.2844 26.8932 4.61027C20.7462 -1.53676 10.7573 -1.53676 4.61027 4.61027C-1.53675 10.7573 -1.53675 20.7462 4.61027 26.8932ZM24.0956 7.36855C28.7058 11.9985 28.7058 19.4853 24.0956 24.0956C19.4853 28.7255 11.9788 28.7255 7.36855 24.0956C2.75828 19.4656 2.73858 11.9788 7.36855 7.36855C11.9985 2.75828 19.4853 2.73858 24.0956 7.36855ZM16.0328 10.5375C16.5851 10.5375 17.0328 10.9852 17.0328 11.5375V15.0341H20.5322C21.0845 15.0341 21.5322 15.4818 21.5322 16.0341C21.5322 16.5864 21.0845 17.0341 20.5322 17.0341H17.0328V20.5306C17.0328 21.0829 16.5851 21.5306 16.0328 21.5306C15.4805 21.5306 15.0328 21.0829 15.0328 20.5306V17.0341H11.5391C10.9868 17.0341 10.5391 16.5864 10.5391 16.0341C10.5391 15.4818 10.9868 15.0341 11.5391 15.0341H15.0328V11.5375C15.0328 10.9852 15.4805 10.5375 16.0328 10.5375Z")
								.swiper-slide.swiper-slide-video
									.swiper-video-container
										.product-swiper__item
											video(controls playsinline muted)
												source(src='/video/video.mp4#t=0.5' type="video/mp4")

							.swiper-pagination
						.swiper.product-swiper-thumb
							.swiper-wrapper
								each image in images
									.swiper-slide
										+picture(image, {
											format: 'jpg',
											path: 'product/',
											alt: '',
											lazy: true,
										})(class="product-swiper__item")
								.swiper-slide
									+picture('product-poster', {
										format: 'jpg',
										path: 'product/',
										alt: '',
										lazy: true,
									})(class="product-swiper__item")
									svg(class="product-swiper__play" width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg")
										path(d="M9.375 15V7.42228L15.9375 11.2111L22.5 15L15.9375 18.7889L9.375 22.5777L9.375 15Z")

block modal
