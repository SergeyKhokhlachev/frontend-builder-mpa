extends ../../layouts/main/main

block data
	-
		const pages = [
			{
				'UI Kit': 'ui-kit.html',
				'Content': 'content.html',
				'Test': 'test.html',
			}, {
				'Главная': 'main.html',
			}, {
				'Категории': 'category.html'
			}, {
				'Магазины': 'shops.html'
			}, {
				'Демо Слайдер': 'product.html'
			}
		]

block main
	.template-page.container
		h1.title-page Список страниц
		.demo-block
			each category in pages
				.demo-block__item
					ul
						each href, name in category
							li
								a(href=href aria-label=name)= name

block modal
