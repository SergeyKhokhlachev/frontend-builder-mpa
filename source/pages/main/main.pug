		section.section.section--medium.section--secondary
			.container
				h2.title-section Последние отзывы
				+swiper-carousel({
					init: 'js-swiper-reviews',
				})
					each item in reviewArray
						.swiper-carousel__slide.swiper-slide
							+card-review(item)

		section.section.section--medium
			.container
				h2.title-section Ответы на частые вопросы
				+faq(faqArray)

		+promo()

		section.section.section--medium
			.container.js-shops

block modal
