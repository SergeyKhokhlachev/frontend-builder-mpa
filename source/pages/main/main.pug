extends ../../layouts/main/main

include ../../components/block/faq/faq
include ../../components/block/promo/promo
include ../../components/block/bannerline/bannerline
include ../../components/card/card-action/card-action
include ../../components/card/card-review/card-review

include ../../components/swiper/swiper-banner/swiper-banner
include ../../components/swiper/swiper-carousel/swiper-carousel

block data
	include ../../api/data/faq/faq
	include ../../api/data/banner/banner
	include ../../api/data/bannerline/bannerline
	include ../../api/data/action/action-array
	include ../../api/data/review/review-array

block main
	.template-page
		+swiper-banner(banner)
		+bannerline(bannerline)

		section.section.section--medium
			.container
				h2.title-section Выгодные предложения
				.grid.grid--quarter
					each item in actionArray
						.grid__col
							+card-action(item)

		section.section.section--largest
			.container
				.tabs.js-tabs
					.tabs__head
						button(class="tabs__button active js-tabs__button" type="button" data-tab="tab-1" aria-label="Описание") Описание
						button(class="tabs__button js-tabs__button" type="button" data-tab="tab-2" aria-label="Хакартеристики") Хакартеристики
						button(class="tabs__button js-tabs__button" type="button" data-tab="tab-3" aria-label="Отзывы") Отзывы
