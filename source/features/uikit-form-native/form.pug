mixin form-uikit-native()
	form(class="js-form-uikit-native" novalidate)
		+form-input({
			id:'native-name',
			name: 'name',
			label: 'Name',
			placeholder: 'Name',
			autocomplete: 'given-name',
			required: true,
			message: 'text',
			rule: 'text',
		})
		+form-input({
			id:'native-email',
			type: 'email',
			name: 'email',
			label: 'Email',
			placeholder: 'user@mail.com',
			autocomplete: 'email',
			required: true,
			message: 'email',
			rule: 'email',
		})
		+form-input({
			id:'native-tel',
			type: 'tel',
			name: 'tel',
			label: 'Phone',
			placeholder: '+7 (999) 999-99-99',
			autocomplete: 'tel',
			required: true,
			message: 'tel',
			rule: 'tel',
			mask: 'tel',
		})
		+form-select({
			id: 'native-category',
			name: 'category',
			label: 'Category',
			placeholder: 'Choose Category',
			required: true,
			message: 'select',
			options: [
				{
					value: 'Medical practice',
					text: 'Medical practice',
				},
				{
					value: 'Organization management',
					text: 'Organization management',
				},
				{
					value: 'Supervision and care activities',
					text: 'Supervision and care activities',
				},
				{
					value: 'Psychological counseling',
					text: 'Psychological counseling',
				},
				{
					value: 'Artistic activity',
					text: 'Artistic activity',
				},
				{
					value: 'Computer software development',
					text: 'Computer software development',
				},
				{
					value: 'Information protection',
					text: 'Information protection',
				},
				{
					value: 'Accounting activities',
					text: 'Accounting activities',
				},
			]
		})
		+form-select({
			id: 'native-skills',
			name: 'skills',
			label: 'Skills',
			placeholder: 'Choose Skills',
			required: true,
			message: 'select',
			multiple: true,
			options: [
				{
					value: 'JavaScript',
					text: 'JavaScript',
				},
				{
					value: 'HTML5',
					text: 'HTML5',
				},
				{
					value: 'CSS3',
					text: 'CSS3',
				},
				{
					value: 'Git',
					text: 'Git',
				},
				{
					value: 'TypeScript',
					text: 'TypeScript',
				},
				{
					value: 'Vue',
					text: 'Vue',
				},
				{
					value: 'Vuex',
					text: 'Vuex',
				},
				{
					value: 'Nuxt',
					text: 'Nuxt',
				},
			],
		})
		+form-complete({
			id: 'native-city',
			name: 'city',
			label: 'City',
			placeholder: 'Input City',
			autocomplete: 'off',
			required: true,
			message: 'city',
		})
		+form-complete({
			id: 'native-address',
			name: 'address',
			label: 'Address',
			placeholder: 'Input Address',
			autocomplete: 'off',
			required: true,
			message: 'address',
		})
		+form-textarea({
			id:'native-textarea',
			name: 'textarea',
			label: 'Comment',
			placeholder: 'Some text',
		})
		+form-file({
			id: 'native-file',
			name: 'file',
			label: 'Photo',
			required: true,
			message: 'file',
		})
		+form-checkbox({
			id: "native-confirm",
			name: "confirm",
			label: "I Agree to Privacy Policy",
			required: true,
			look: 'true',
		})
		button(class="button button--primary" type="submit") Submit

