{
	"source": {
		"include": ["./source"],
		"exclude": ["node_modules", "./source/templates"],
		"includePattern": ".+\\.(jsx|js|ts|tsx)$",
		"excludePattern": "(^|\\/|\\\\)_"
	},
	"tags": {
		"allowUnknownTags": ["category"]
	},
	"plugins": [
		"node_modules/better-docs/typescript",
		"node_modules/better-docs/category"
	],
	"opts": {
		"encoding": "utf8",
		"readme": "JSDOC.md",
		"destination": "docs",
		"recurse": true,
		"private": true,
		"verbose": true,
		"template": "node_modules/better-docs"
	}
}
