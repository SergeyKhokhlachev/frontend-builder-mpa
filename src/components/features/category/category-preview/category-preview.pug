mixin category-preview(props = {})
	-
		props = {
			image: props.image || '',
			name: props.name || '',
			quantity: props.quantity || '',
		};

	a.category-preview(href='/pages/catalog.html', aria-label=`Категория: ${props.name}, ${props.quantity}`)&attributes(attributes)
		span.category-preview__quantity(aria-hidden='true')= props.quantity
		h3.category-preview__name(aria-hidden='true')= props.name
		+picture(props.image, { format: 'png', alt: props.name })
