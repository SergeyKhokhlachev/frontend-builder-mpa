mixin product-short(props = {})
	-
		props = {
			image: props.images[0] || '',
			name: props.name || '',
			href: props.href || '#',
			priceNew: props.priceNew || '',
			priceOld: props.priceOld || '',
			marker: props.markers[0] || {},
			favorite: props.favorite || false,
		};

	article.product-short&attributes(attributes)
		button.favorite(
			type='button',
			role='checkbox',
			aria-pressed=props.favorite,
			aria-label='Добавить в избранное',
			class={ active: props.favorite }
		)
			.favorite__icons
				+icon('favorite')
				+icon('favorite-fill')
		span.marker(style='color: ' + props.marker.color + '; background: ' + props.marker.background)= props.marker.value
		a.product-short__body(href=props.href, aria-label='Перейти на страницу товара')
			.product-short__preview
				+picture(props.image)
			.product-short__content
				h3.product-short__name= props.name
				.product-short__coast
					span.product-short__price-new= props.priceNew + ' ₽'
					span.product-short__price-old= props.priceOld + ' ₽'
