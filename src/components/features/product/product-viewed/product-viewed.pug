include /components/features/product/product-short/product-short

mixin product-viewed(props = [])
	-
		props = props || [];

	.product-viewed&attributes(attributes)
		+swiper-carusel.js-swiper-viewed(role='region', aria-label='Карусель просмотренных товаров')
			each product in props
				.swiper-slide(role='listitem')
					+product-short(product)
