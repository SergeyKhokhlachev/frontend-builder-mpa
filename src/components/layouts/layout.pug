include /components/shared/icon/icon
include /components/shared/picture/picture
include /components/shared/modal/modal
include /components/shared/breadcrumbs/breadcrumbs
include /components/shared/rating/rating
include /components/shared/swiper/swiper-banner/swiper-banner
include /components/shared/swiper/swiper-carusel/swiper-carusel
include /components/shared/swiper/swiper-thumbs/swiper-thumbs
include /components/shared/swiper/swiper-over/swiper-over
include /components/shared/form/form-checkbox/form-checkbox
include /components/shared/form/form-code/form-code
include /components/shared/form/form-file/form-file
include /components/shared/form/form-input/form-input
include /components/shared/form/form-radio/form-radio
include /components/shared/form/form-select/form-select
include /components/shared/form/form-textarea/form-textarea

include /components/layouts/header/header
include /components/layouts/footer/footer
include /components/features/search/search
include /components/features/subscribe/subscribe
include /components/features/location/location
include /components/features/callback/callback
include /components/features/callback/callback-form/callback-form

-
	let auth = false;
	let title = 'Page list'

include /api/data/footer
include /api/data/header

block data

doctype html
html(lang='ru')
	head
		include /common/head.pug
		title= title
		link(rel='stylesheet', crossorigin, href='/templates/bundle.css')
		script(type='module', src='/templates/bundle.js')

	body.wrapper(data-barba='wrapper')
		.page-loader.active.js-page-loader
		+header(headerData, { auth: auth }).js-sticky-indent

		block main

		+subscribe
		+footer(footerData)

		.notify-layer.js-notify-layer
		.modal-layer.js-modal-layer.js-modal-close

		+modal-window({ id: 'modal-callback', title: 'Заказать звонок', text: 'Если вы не желаете дожидаться ответа по нашей Горячей Линии, то просто оставьте свой номер телефона и мы сами вам перезвоним' }).modal-window--small
			+callback-form

		+modal-window({ id: 'modal-login' }).modal-window--small
			.js-login-vue

		+modal-window({ id: 'modal-location', title: 'Выбор города' }).modal-window--small
			.js-location-search-vue
