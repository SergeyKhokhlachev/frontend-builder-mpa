include /components/shared/form/form-element/form-element

mixin form-input(props = {})
	-
		props = {
			id: props.id,
			name: props.name,
			value: props.value || false,
			type: props.type || 'text',
			label: props.label || false,
			describe: props.describe || false,
			placeholder: props.placeholder || false,
			autocomplete: props.autocomplete || 'off',
			required: props.required || false,
			disabled: props.disabled || false,
			message: props.message,
			rule: props.rule,
		}

	//- prettier-ignore
	+form-element({
		label: props.label,
		describe: props.describe,
		required: props.required,
		disabled: props.disabled,
	})
		.form-element
			input.form-input.js-form-input(
				id=props.id,
				value=props.value,
				type=props.type,
				name=props.name,
				placeholder=props.placeholder,
				autocomplete=props.autocomplete,
				required=props.required,
				disabled=props.disabled,
				maxlength=props.type === 'tel' ? 18 : undefined,
				data-message=props.message || props.type,
				data-rule=props.rule || props.type,
			)
			if props.type === 'password'
				.form-element__icon.js-form-element__shown
					+icon('eye-close').form-element__icon-show
					+icon('eye-open').form-element__icon-hide
