mixin form-element(props = {})
	-
		props = {
			label: props.label || false,
			describe: props.describe || false,
			required: props.required || false,
			disabled: props.disabled || false,
		}

	.form-element.js-form-element(class={ disabled: props.disabled })&attributes(attributes)
		label
			if props.label
				span.form-element__label= props.label
				if props.required
					span.form-element__required(aria-hidden='true') *

			block

		if props.describe
			.form-element__describe= props.describe

		.form-element__message.js-form-element__message
