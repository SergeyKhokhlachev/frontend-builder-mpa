extends /layout/layout

include /components/features/category/category-card/category-card
include /components/features/product/product-viewed/product-viewed

block data
	include /api/data/categories
	include /api/data/products

	-
		const breadcrumbs = {
			'Главная': '/pages/main.html',
			'Каталог': '',
		}

		const productsViewed = products.slice(0,6);

block main
	.page(data-barba='container', data-barba-namespace='base-content')
		section.section.section--padding
			.base-content.container
				h1 Большие чемоданы
				h2 Ознакомьтесь с правилами провоза багажа.
				+picture('promo--tablet', { alt: 'Картинка' })
