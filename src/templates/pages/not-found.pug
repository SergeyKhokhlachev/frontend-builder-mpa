extends /components/layouts/layout

block data
	-
		title = 'Page Not Found';

block main
	.page(data-barba='container', data-barba-namespace='not-found')
		main.not-found.container
			.not-found__error 404
			.not-found__title Страница не найдена
			.not-found__text Неправильно набран адрес или такой страницы не существует
			a.button.button--primary(href='/pages/main.html') На главную
