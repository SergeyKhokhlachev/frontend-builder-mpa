extends /components/layouts/layout

include /components/features/uikit/uikit-form-native/uikit-form-native

block data
	include /api/data/ui-kit/color-array
	include /api/data/ui-kit/icon-array

	-
		title = 'Page UI Kit';

block main
	.page(data-barba='container', data-barba-namespace='ui-kit')
		main.ui-kit.container
			section.ui-kit__section
				h2.ui-kit__title COLOR
				.ui-kit__content
					each category in colorArray
						.ui-kit__title-sub= category.title
						.ui-kit__list
							each item in category.list
								.ui-kit__color(style=`background-color: var(--${item})`, data-icon='icon')
									span= item

			section.ui-kit__section
				h2.ui-kit__title ICON
				.ui-kit__content
					.ui-kit__list
						each icon in iconArray
							.ui-kit__icon
								+icon(icon)
								span= icon

			section.ui-kit__section
				.ui-kit__title ELEMENTS
				.ui-kit__content
					.ui-kit__title-sub links
					.ui-kit__list
						.ui-kit__item
							a.link(href='#', aria-label='link')
								span link
						.ui-kit__item
							a.link.link--dashed(href='#', aria-label='link--dashed')
								span link--dashed
					.ui-kit__title-sub buttons
					.ui-kit__list
						.ui-kit__item
							button.button.button--primary(type='button', aria-label='button primary')
								span button primary
						.ui-kit__item
							button.button.button--secondary(type='button', aria-label='button secondary')
