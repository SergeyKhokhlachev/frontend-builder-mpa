extends /layout/layout

include /components/features/product/product-filter/product-filter
include /components/features/product/product-card/product-card
include /components/features/product/product-viewed/product-viewed

block data
	include /api/data/products
	-
		const breadcrumbs = {
			'Главная': '/pages/main.html',
			'Каталог': '/pages/category.html',
			'Одежда': '',
		}

		const select = {
			id: 'catalog-sort',
			name: 'sort',
			value: 'По популярности',
			placeholder: 'Выберите из списка...',
			icon: 'sort',
			options: [
				{ id: 'catalog-sort-popular', value: 'По популярности', label: 'По популярности' },
				{ id: 'catalog-sort-new', value: 'Новинки', label: 'Новинки' },
				{ id: 'catalog-sort-cheap', value: 'Сначала дешевые', label: 'Сначала дешевые' },
				{ id: 'catalog-sort-expensive', value: 'Сначала дорогие', label: 'Сначала дорогие' },
				{ id: 'catalog-sort-rating', value: 'Высокий рейтинг', label: 'Высокий рейтинг' },
			],
		}

		const productsViewed = products.slice(0,6);

block main
	.page(data-barba='container', data-barba-namespace='catalog')
		+breadcrumbs(breadcrumbs)
		.catalog.container
			h1.page-title Одежда
			.catalog__template
				aside.catalog__aside.js-sticky-track
					.sticky.js-sticky
						+product-filter
				main.catalog__main
					h2.visually-hidden Список товаров в категории "Одежда"
					.catalog__head
						form.catalog__sort.js-product-sort(novalidate)
							+form-select(select)
						button.catalog__control.js-filter-open(type='button', aria-label='Открыть фильтр')
							+icon('filter')
							span Фильтр
					.catalog__row
						each product in products
							.catalog__col
								+product-card(product)

		section.section.section--padding.section--color
			.container
				h2.page-title Ранее вы смотрели
				+product-viewed(productsViewed)
