<mjml>
	<mj-head>
		<mj-title>Email Title</mj-title>
		<mj-preview>Email preview text</mj-preview>
		<mj-attributes>
			<mj-all font-family="Arial" />
			<mj-text padding="0" />
		</mj-attributes>
		<mj-style>
			
		</mj-style>
	</mj-head>
	<mj-body width="620px" background-color="#F5F8FA">
		<mj-section padding="0">
			<mj-column>
				<mj-image width="180px" padding="35px 0 28px" src="./images/logo.png"></mj-image>
			</mj-column>
		</mj-section>
		<mj-section padding="0">
			<mj-column>
				
			</mj-column>
		</mj-section>
		<mj-wrapper padding="6px" border="4px solid #FFF">
			<mj-section padding="54px 30px" background-color="#FFF">
				<mj-column>
					<mj-text>
						<h1 style="margin: 0 0 14px; color: #717171; font-size: 24px; font-weight: 700; line-height: 1.3">Ваши результаты диагностики кожи</h1>
						<p style="margin: 0; color: #212121; font-size: 15px; font-weight: 400; line-height: 1.6">По результатам диагностики вас нормальная кожа</p>
						<p style="margin: 0; color: #212121; font-size: 14px; font-weight: 400; line-height: 1.6">Спасибо, что выбираете NAOS!</p>
					</mj-text>
				</mj-column>
			</mj-section>
		</mj-wrapper>
	</mj-body>
</mjml>
